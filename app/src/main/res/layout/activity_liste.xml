<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fond"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titreListe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titre_liste"
        android:textColor="@color/bleu_marine"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Barre de recherche : le champ prend tout l'espace restant (poids 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/champVille"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_ville"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/boutonChercher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_chercher" />
    </LinearLayout>

    <!-- Qui est connecté + boutons Connexion et « + » -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/etatSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/boutonConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_connexion" />

        <Button
            android:id="@+id/boutonAjouter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/btn_ajouter"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Caché tant qu'il n'y a pas d'erreur -->
    <TextView
        android:id="@+id/messageErreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/rouge"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Les cartes sont ajoutées en Java dans conteneurLogements -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/conteneurLogements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>

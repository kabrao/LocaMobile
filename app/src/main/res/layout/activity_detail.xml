<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fond"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titre_detail"
        android:textColor="@color/bleu_marine"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Chargement, 404, erreur HTTP ou serveur injoignable -->
    <TextView
        android:id="@+id/etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/rouge"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/carteDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/fond_carte"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/detailTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bleu_marine"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailVille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detailPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/orange"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailVoyageurs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detailProprietaire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
